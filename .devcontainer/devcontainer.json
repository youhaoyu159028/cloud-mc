{
  "name": "cloud-mc",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash /workspaces/cloud-mc/.devcontainer/setup.sh",
  "postStartCommand": "bash /workspaces/cloud-mc/.devcontainer/start-vnc.sh",
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    },
    "5901": {
      "label": "VNC Remote Desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Lopleec.minecraft-workbench",
        "vscjava.vscode-java-pack",
        "GitHub.vscode-pull-request-github"
      ]
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "NOVNC_PORT": "6080",
    "VNC_PORT": "5901"
  }
}
