{
  "name": "cloud-mc",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC - Minecraft desktop",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Lopleec.minecraft-workbench",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "terminal.integrated.env.linux": {
          "DISPLAY": ":1"
        }
      }
    }
  }
}
